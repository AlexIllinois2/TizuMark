# 统一行尾为 LF，消除 Windows autocrlf=true 导致的 CRLF/LF 转换问题
* text=auto eol=lf

# Windows 批处理脚本必须使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件 - 不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.exe binary
*.msi binary
*.sig binary
*.dll binary
*.lib binary
*.so binary
*.dylib binary
*.o binary
*.a binary
*.rlib binary
*.rmeta binary
*.pdb binary
*.d binary
